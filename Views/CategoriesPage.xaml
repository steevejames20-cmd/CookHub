<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="Root" x:Class="CookHub.Views.CategoriesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CookHub.Controls"
             Title="Catégories"
             Shell.NavBarIsVisible="False">
    <!-- Interface 7 : Catégories (maquette, écran 7). -->
    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,24" Spacing="16">

            <Label Text="Mon carnet" Style="{StaticResource Caption}" FontSize="15" />
            <Label Text="À chaque envie, sa catégorie." Style="{StaticResource Display}" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource Help}" FontSize="14" />

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- Catégorie vide : fond sauge, comme la catégorie "Boissons" de la maquette -->
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenCategoryCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasRecipes}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Sage}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border BackgroundColor="{DynamicResource Sage}" StrokeThickness="0"
                                        WidthRequest="72" HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <controls:IconView Icon="book" WidthRequest="26" HeightRequest="26"
                                                           Fill="{DynamicResource PrimaryBrush}" />
                                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="22" />
                                    <Label Text="{Binding CountText}" Style="{StaticResource Help}" />
                                </VerticalStackLayout>
                                <controls:IconView Grid.Column="2" Icon="chevron" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Créer une catégorie" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CreateCategoryCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
