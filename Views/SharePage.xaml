<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CookHub.Views.SharePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CookHub.Controls"
             Title="Partager"
             Shell.TabBarIsVisible="False">
    <!-- Interface 8 : Partage de recette (maquette, écran 8). -->
    <ScrollView>
        <VerticalStackLayout Padding="24,8,24,32" Spacing="16">

            <Label Text="Les bonnes choses se transmettent." Style="{StaticResource Display}" />
            <Label Text="Envoyez cette recette, pas un message qui se perd." Style="{StaticResource Help}"
                   FontSize="14" />

            <!-- Rappel de la recette partagée -->
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                    <Border BackgroundColor="{DynamicResource Sage}" StrokeThickness="0"
                            WidthRequest="72" HeightRequest="72">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid>
                            <controls:IconView Icon="book" WidthRequest="26" HeightRequest="26"
                                               Fill="{DynamicResource PrimaryBrush}" />
                            <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Category}" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="20" />
                        <Label Text="{Binding Summary}" Style="{StaticResource Help}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Banner}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Accessible avec le lien" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                    <Label Text="Vos proches peuvent consulter la photo, les ingrédients et toutes les étapes, sans compte."
                           FontSize="13" />
                    <Label Text="Seule cette recette est partagée. Votre carnet reste privé."
                           Style="{StaticResource Help}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="Lien de la recette" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource FieldBox}">
                    <Label Text="{Binding Link}" VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Copier le lien" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CopyLinkCommand}" />
            <Label Text="{Binding Feedback}" Style="{StaticResource Help}" HorizontalOptions="Center"
                   IsVisible="{Binding HasFeedback}" />

            <Label Text="Envoyer à un proche" Style="{StaticResource Heading}" FontSize="20" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Style="{StaticResource Card}" Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <controls:IconView Icon="chat" />
                        <Label Text="Message" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendEmailCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <controls:IconView Icon="mail" />
                        <Label Text="E-mail" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareOtherCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <controls:IconView Icon="more" />
                        <Label Text="Autres" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
