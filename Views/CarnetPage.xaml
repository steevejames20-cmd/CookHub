<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="Root" x:Class="CookHub.Views.CarnetPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CookHub.Controls"
             Title="Carnet"
             Shell.NavBarIsVisible="False">
    <!--
        Interfaces 3, 9 et 10 : Mon carnet de recettes, carnet vide et chargement.
        Les trois états sont affichés selon ShowLoading, ShowEmpty et ShowContent.
    -->
    <Grid RowDefinitions="Auto,*">

        <!-- Barre du haut : nom de l'application et menu du compte -->
        <Grid Padding="24,12" ColumnDefinitions="*,Auto">
            <Label Text="CookHub" Style="{StaticResource Heading}" FontSize="20" VerticalOptions="Center" />
            <controls:IconView Grid.Column="1" Icon="user">
                <controls:IconView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAccountMenuCommand}" />
                </controls:IconView.GestureRecognizers>
            </controls:IconView>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,24" Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Greeting}" Style="{StaticResource Eyebrow}" />
                    <Label Text="Mon carnet de recettes" Style="{StaticResource Display}" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Help}" FontSize="14" />
                </VerticalStackLayout>

                <!-- ETAT : chargement (squelette en blocs gris, aucun visuel à télécharger) -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowLoading}">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator IsRunning="{Binding ShowLoading}" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Votre carnet se prépare…" Style="{StaticResource Help}" FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource SkeletonBlock}" HeightRequest="48" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource SkeletonBlock}" HeightRequest="150" />
                            <Border Style="{StaticResource SkeletonBlock}" HeightRequest="16" WidthRequest="200"
                                    HorizontalOptions="Start" />
                            <Border Style="{StaticResource SkeletonBlock}" HeightRequest="12" WidthRequest="120"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ETAT : carnet vide -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowEmpty}">
                    <Border BackgroundColor="{DynamicResource Sage}" StrokeThickness="0"
                            WidthRequest="96" HeightRequest="96" HorizontalOptions="Start" Margin="0,16,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="48" />
                        </Border.StrokeShape>
                        <controls:IconView Icon="book" WidthRequest="40" HeightRequest="40"
                                           Fill="{DynamicResource PrimaryBrush}" />
                    </Border>
                    <Label Text="Une première page à écrire." Style="{StaticResource Heading}" />
                    <Label Text="La tarte de mamie, votre plat du dimanche… Ajoutez une première recette pour ne plus jamais la perdre."
                           Style="{StaticResource Help}" FontSize="14" />
                    <Button Text="Ajouter ma première recette" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddFirstRecipeCommand}" />
                    <Border Style="{StaticResource Banner}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Un message peut devenir une recette." FontAttributes="Bold" />
                            <Label Text="Copiez les ingrédients et les étapes d’un message, ajoutez une photo et gardez le tout dans votre carnet."
                                   Style="{StaticResource Help}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ETAT : liste des recettes -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowContent}">

                    <controls:FieldEntry Caption="Retrouver une recette"
                                         Placeholder="Rechercher dans mon carnet"
                                         Text="{Binding SearchText}" />

                    <controls:CategoryChips Items="{Binding Filters}" Command="{Binding SelectFilterCommand}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="À cuisiner bientôt" Style="{StaticResource Heading}" FontSize="20" />
                        <Label Grid.Column="1" Text="{Binding SortLabel}" Style="{StaticResource LinkLabel}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Label Text="Aucune recette ne correspond à votre recherche."
                           Style="{StaticResource Help}" FontSize="14" IsVisible="{Binding ShowNoMatch}" />

                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Recipes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <controls:RecipeCard>
                                    <controls:RecipeCard.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenRecipeCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </controls:RecipeCard.GestureRecognizers>
                                </controls:RecipeCard>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
