<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="CookHub.Controls.RecipeCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CookHub.Controls">
    <!--
        Carte de recette (liste du carnet et résultats de recherche).
        Le BindingContext est un objet Recipe.
        Une seule photo par recette : sans photo, un fond sauge avec une icône prend la place.
    -->
    <Border Style="{StaticResource Card}" Padding="0">
        <VerticalStackLayout>
            <Grid HeightRequest="180" BackgroundColor="{DynamicResource Sage}">
                <controls:IconView Icon="book" WidthRequest="40" HeightRequest="40"
                                   Fill="{DynamicResource PrimaryBrush}" />
                <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
            </Grid>
            <VerticalStackLayout Padding="16,12,16,16" Spacing="2">
                <Label Text="{Binding Category}" Style="{StaticResource Eyebrow}" />
                <Label Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="21" />
                <Label Text="{Binding Summary}" Style="{StaticResource Help}" />
                <Label Text="{Binding AddedLabel}" Style="{StaticResource Help}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
