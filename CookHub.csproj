<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Cible Android uniquement : le mode simulation utilise l'émulateur Android. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>CookHub</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Identité de l'application -->
		<ApplicationTitle>CookHub</ApplicationTitle>
		<ApplicationId>com.enspd.cookhub</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône et écran de démarrage (couleurs de la charte graphique) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3F6B46" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FAF7F0" BaseSize="128,128" />

		<!-- Images vectorielles (icônes de la barre d'onglets) -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Polices : déposer Lora-Regular.ttf et Inter-Regular.ttf dans Resources\Fonts (voir README). -->
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MVVM : génération automatique des propriétés et des commandes -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
	</ItemGroup>

</Project>
