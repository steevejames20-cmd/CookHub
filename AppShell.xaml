<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="CookHub.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CookHub.Views"
       FlyoutBehavior="Disabled"
       Shell.NavBarHasShadow="False">

    <!-- Écran affiché avant l'authentification (premier élément = écran de départ) -->
    <ShellContent Title="Connexion" Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Barre de navigation inférieure : 4 onglets toujours accessibles -->
    <TabBar x:Name="MainTabs" Route="main">
        <ShellContent Title="Carnet" Icon="tab_carnet.svg" Route="carnet"
                      ContentTemplate="{DataTemplate views:CarnetPage}" />
        <ShellContent Title="Recherche" Icon="tab_recherche.svg" Route="recherche"
                      ContentTemplate="{DataTemplate views:SearchPage}" />
    </TabBar>

</Shell>
